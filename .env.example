# Server Configuration
PORT=3000
SERVER_DOMAIN=localhost:3000

# AI Provider: 'gemini' (Recommended) or 'openai'
AI_PROVIDER=gemini

# Google Gemini Configuration
# Get your free Gemini API key from https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here
# Gemini Live Model: gemini-2.0-flash-exp, gemini-2.5-flash, or gemini-2.0-flash-realtime
GEMINI_LIVE_MODEL=gemini-2.0-flash-exp

# OpenAI Configuration (Optional fallback)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_BASE_URL=https://api.openai.com
OPENAI_REALTIME_MODEL=gpt-4o-realtime-preview

# Cloudflare Turnstile Configuration
# Test site key: 1x00000000000000000000AA (always passes for testing)
# Test secret key: 1x0000000000000000000000000000000AA
NEXT_PUBLIC_CLOUDFLARE_SITE_KEY=1x00000000000000000000AA
CLOUDFLARE_SECRET_KEY=1x0000000000000000000000000000000AA
